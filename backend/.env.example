# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB is the PRIMARY datastore for PaperTradeX.
MONGODB_URI=mongodb://localhost:27017/papertradex
# Optional Redis URL (for caching / pubsub if enabled later)
REDIS_URL=redis://default:password@localhost:6379

# ── Security (REQUIRED) ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=5000

# ── CORS / URLs ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Admin seed ────────────────────────────────────────────────────────────────
# If ADMIN_PASSWORD is blank, admin seeding is skipped on startup.
ADMIN_EMAIL=admin@papertradex.com
ADMIN_PASSWORD=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# See README for Google Cloud Console setup steps.
GOOGLE_CLIENT_ID=

# ── SMTP (password-reset emails) ─────────────────────────────────────────────
# Leave blank to log reset links to the console instead (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PaperTradeX <no-reply@papertradex.com>

# ── AI providers (optional) ───────────────────────────────────────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
